# GradTools API — copy to .env for local development. NEVER commit .env.
# Authority: docs/25_DEPLOYMENT_AND_ENVIRONMENTS.md §25.4

NODE_ENV=development
APP_ENV=local
PORT=3001

# SECRET. Owned by the API. Never exposed to the browser.
DATABASE_URL=postgres://gradtools@localhost:55432/gradtools_dev

# CORS allowlist, comma separated. No wildcard is accepted.
WEB_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Master switch for external source polling. Off in every environment.
# No ingestion exists yet; the variable is validated so the default cannot drift.
INGESTION_ENABLED=false
