# GradTools API — copy to .env for local development. NEVER commit .env.
# On a host, set these in the service's environment settings instead. Every
# value here is SERVER-ONLY: none may ever be a VITE_ variable, because VITE_
# values are compiled into the browser bundle.
# Authority: docs/25_DEPLOYMENT_AND_ENVIRONMENTS.md §25.4 · docs/48_STAGING_AND_ANDROID.md

NODE_ENV=development
# local | test | experimental | staging | alpha. In staging and alpha the API
# refuses to start unless WEB_ORIGIN is set explicitly and every origin is https.
APP_ENV=local
# Loopback for local work. The Docker image sets 0.0.0.0, which is safe: no
# route is unauthenticated (operator writes need OPERATOR_TOKEN, /api/v1/me
# routes need a Supabase session). CORS is NOT the control — curl ignores it.
HOST=127.0.0.1
# A host that assigns its own port overrides this.
PORT=3001

# SECRET. Owned by the API. Never exposed to the browser.
DATABASE_URL=postgres://gradtools@localhost:55432/gradtools_dev

# CORS allowlist, comma separated, exact origins. No wildcard is accepted.
# Staging example: https://<your-static-site>,https://localhost
# (https://localhost is the Android app's own origin under Capacitor.)
WEB_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Master switch for external source polling. Off in every environment.
INGESTION_ENABLED=false

# SECRET, optional. The operator credential for announcement entry and
# publication. Unset: those two routes do not exist (404). Set: at least 32
# characters and generated, never chosen — for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# OPERATOR_TOKEN=

# --- Student cloud (Supabase). Leave unset to serve the public surface only.
# PUBLIC: the project URL, used to verify session tokens.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SECRET: must name the `authenticator` role (no bypassrls); the API refuses to
# start otherwise (docs/13 §13.17).
# SUPABASE_DB_URL=postgres://authenticator:<password>@db.<project-ref>.supabase.co:5432/postgres
# SECRET, optional: used only to delete an account.
# SUPABASE_ADMIN_DB_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
