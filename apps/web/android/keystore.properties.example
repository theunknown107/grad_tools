# Release signing credentials for the GradTools Android app (Option A — local).
#
# Copy this file to `keystore.properties` (same directory) and fill in your
# values. `keystore.properties` and all keystore files (*.jks / *.keystore) are
# GIT-IGNORED — they must NEVER be committed, logged, or put in a release asset.
#
# Keep the keystore itself OUTSIDE the repository, in a dedicated local signing
# directory, and point `storeFile` at it with an ABSOLUTE path.
#
# Generate a keystore once (do NOT lose it — it must sign every future update):
#   keytool -genkeypair -v -storetype PKCS12 -keyalg RSA -keysize 4096 \
#     -validity 10000 -alias gradtools \
#     -keystore /absolute/path/to/signing/gradtools-release.jks
#
# build.gradle loads these only when the file is present; a release build without
# valid signing fails with a clear message. Debug builds ignore this entirely.

storeFile=/absolute/path/to/signing/gradtools-release.jks
storePassword=CHANGE_ME
keyAlias=gradtools
keyPassword=CHANGE_ME
