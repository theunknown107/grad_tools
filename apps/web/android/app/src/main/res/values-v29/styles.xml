<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 29+: the same theme as values/styles.xml, plus an opt-out of the
         system's force dark. GradTools has its own dark theme, so Android must
         not darken the light one (device test 2026-11-05). MainActivity also
         turns off WebView's algorithmic darkening. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
