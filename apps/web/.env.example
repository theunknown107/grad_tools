# GradTools web — public configuration only. Copy to apps/web/.env.local.
#
# VITE_ variables are COMPILED INTO THE BROWSER BUNDLE (and into the Android
# app). A secret must never appear here. The database URL, OPERATOR_TOKEN and
# every server secret live in services/api/.env, and the browser never sees
# them (M5a §13). Vite reads env files from THIS directory, not the repo root.

# Base URL of the GradTools API, no trailing slash. Unset: development uses
# http://localhost:3001 and a production build uses its own origin. Required
# for any build served from a different origin than the API — every staging
# static site, and the Android app. Must be https:// for those.
VITE_API_URL=http://localhost:3001

# PUBLIC Supabase values (the publishable key reaches only RLS-protected rows,
# and only as whoever is signed in — docs/09 §9.18). Unset: no accounts.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
