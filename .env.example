# GradTools environment configuration
#
# Copy to .env for local development. NEVER commit .env.
# Authority: docs/25_DEPLOYMENT_AND_ENVIRONMENTS.md §25.4
#
# No variables are required yet: the academic-rules package is pure and reads no
# configuration. This file exists so the pattern is established before the API
# introduces secrets, and so `.gitignore` has something to protect.

# --- Runtime -----------------------------------------------------------------
# NODE_ENV=development
# APP_ENV=local

# --- API (milestone M2.3, not yet implemented) -------------------------------
# PORT=3000
# DATABASE_URL=postgres://user:password@localhost:5432/gradtools
# WEB_ORIGIN=http://localhost:5173

# --- Ingestion ---------------------------------------------------------------
# Master switch for ALL external source polling. Defaults to false everywhere.
# A source additionally requires its own `enabled` flag AND a recorded robots
# check before it can run (docs/14 §14.3).
# INGESTION_ENABLED=false

# --- Optional AI (docs/19) ---------------------------------------------------
# Disabled by default. Never receives student data.
# LLM_ENABLED=false

# ---------------------------------------------------------------------------
# The student cloud (M9)
# ---------------------------------------------------------------------------
#
# PUBLIC — these two are meant to be in a browser. The publishable key can only
# reach RLS-protected tables, and only as whoever is signed in (docs/09 §9.18).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

# The same project URL, for the API's JWT verification. Public.
# SUPABASE_URL=https://<project-ref>.supabase.co

# SECRET. Must name the `authenticator` role — a role with NO bypassrls. The
# API refuses to start if this connection can bypass row-level security,
# because that would silently disable every authorization policy in the schema
# (docs/13 §13.17).
# SUPABASE_DB_URL=postgres://authenticator:<password>@db.<ref>.supabase.co:5432/postgres

# SECRET, and optional. Used for exactly one operation — deleting an account,
# which has to remove a row from auth.users. Where it is absent, account
# deletion reports itself unavailable rather than half working (M9 §34, §44).
# SUPABASE_ADMIN_DB_URL=postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# NEVER PUT THESE IN ANY FILE THAT IS COMMITTED, and never in a VITE_ variable
# (everything VITE_ is compiled into the browser bundle):
#   the service-role key, the database password, OAuth client secrets,
#   the Apple Sign-In private key, any JWT signing secret.
