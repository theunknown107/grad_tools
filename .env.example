# GradTools environment configuration
#
# Copy to .env for local development. NEVER commit .env.
# Authority: docs/25_DEPLOYMENT_AND_ENVIRONMENTS.md §25.4
#
# No variables are required yet: the academic-rules package is pure and reads no
# configuration. This file exists so the pattern is established before the API
# introduces secrets, and so `.gitignore` has something to protect.

# --- Runtime -----------------------------------------------------------------
# NODE_ENV=development
# APP_ENV=local

# --- API (milestone M2.3, not yet implemented) -------------------------------
# PORT=3000
# DATABASE_URL=postgres://user:password@localhost:5432/gradtools
# WEB_ORIGIN=http://localhost:5173

# --- Ingestion ---------------------------------------------------------------
# Master switch for ALL external source polling. Defaults to false everywhere.
# A source additionally requires its own `enabled` flag AND a recorded robots
# check before it can run (docs/14 §14.3).
# INGESTION_ENABLED=false

# --- Optional AI (docs/19) ---------------------------------------------------
# Disabled by default. Never receives student data.
# LLM_ENABLED=false
