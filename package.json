{
  "name": "gradtools",
  "version": "0.1.0",
  "private": true,
  "description": "Student-facing academic utility layer that brings routine academic workflows and information into one place.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "qa:visual": "node tests/visual-qa.mjs",
    "qa:visual:seeded": "node tests/visual-qa-seeded.mjs",
    "test:api": "vitest run --project api",
    "db:migrate": "pnpm --filter @gradtools/api migrate",
    "db:seed": "pnpm --filter @gradtools/api seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
