# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# test / coverage
coverage/
.vitest/
test-results/
playwright-report/
# Visual QA output is regenerated by `pnpm qa:visual` on every run.
tests/screenshots/

# environment & secrets  (12_PRIVACY, 13_SECURITY, 25_DEPLOYMENT)
.env
.env.*
!.env.example

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# real student data must never be committed (12_PRIVACY §12.11, 22_TESTING §22.11)
*.grade-card.json
fixtures/private/

# Document object storage. The configured root lives OUTSIDE the repository
# (docs/25 section 25.6.3); this is a guard in case someone points it inside.
storage/
*.storage/

# Human-supplied question papers and solutions, for local pipeline testing only.
# NEVER committed: rights are unresolved (OQ-008) and these are third-party
# academic material. The pipeline reads them from disk; only derived metrics and
# non-identifying fixtures reach the repository (M5A section 3).
qpapers_and solutions_sample/

# M9.4 design references — third-party work, licensing unknown. Local only.
GradTools_M9.4_Reference_Images/

# Seeded visual-QA output (docs/22 §22.21). Screenshots of synthetic data.
# Local QA output: screenshots and reports from the browser harnesses. One
# glob rather than a line per milestone -- M10B.2 added a directory, the line
# that would have ignored it was skipped by a failed && chain, and two PNGs
# reached a commit that forbids them.
.qa-*/
# Generated QA output, consolidated under one tree. Screenshots, reports and
# any private ground-truth a person wrote for their own documents live here and
# none of it belongs in the repository.
.qa/

# Supplied academic reference images. REAL student/institutional PII —
# inspected locally, never committed (see docs/12, docs/30).
GradTools_Academic_References_5_Images/
# Real academic documents the owner supplied as parser references. A result
# card, a calendar and a timetable carry names, seat numbers, marks, faculty
# contact details and roll ranges. They are read locally and never committed.
GradTools_Academic_Calendar_and_Timetable_References/

# OCR engine assets, copied out of node_modules by
# apps/web/scripts/vendor-ocr-assets.mjs so they are served from our own origin
# rather than a CDN (M10A.6B). Several megabytes of build output that npm
# already holds canonically — committing them would put binaries in the history
# to no purpose.
apps/web/public/ocr/

# Supplied UI reference material — third-party design work, licensing unknown,
# same rule as the other reference folders. Read locally, never committed.
UI clone reference/
